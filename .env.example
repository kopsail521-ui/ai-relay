# Copy to .env (gitignored). Never commit real keys.

# Image / media channel
CHANNEL_IMAGES_BASE_URL=https://example.invalid
CHANNEL_IMAGES_API_KEY=sk-replace-me

# Primary chat channel
CHANNEL_PRIMARY_BASE_URL=https://example.invalid
CHANNEL_PRIMARY_API_KEY=sk-replace-me

# Free-tier chat channel (public name: Keyo Free) — 由 services/unofree-pool 提供
# 上游：UnoRouter 免费模型池（多 key 逗号分隔，免费额度叠加）
UNO_API_KEYS=sk-uno-replace-me
# 下游密钥：粉丝/中转站调用免费池用的 key（New API 渠道里填这个）
POOL_API_KEYS=sk-pool-replace-me
CHANNEL_FREE_BASE_URL=http://127.0.0.1:3020
CHANNEL_FREE_API_KEY=sk-pool-replace-me

# Video / specialty passthrough (:3011)
CHANNEL_VIDEO_BASE_URL=https://example.invalid
CHANNEL_VIDEO_API_KEY=sk-replace-me

# Specialty media passthrough (:3010)
CHANNEL_MEDIA_BASE_URL=https://example.invalid
CHANNEL_MEDIA_API_KEY=sk-replace-me

# New API admin
NEW_API_BASE=http://127.0.0.1:3000
NEW_API_ADMIN_USER=root
NEW_API_ADMIN_PASSWORD=your-admin-password

# Pricing workbook
ADMIN_PASSWORD=admin123
PORT=3100
