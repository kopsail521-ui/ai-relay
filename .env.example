# Copy to .env (gitignored). Never commit real keys.

# Image / media channel
CHANNEL_IMAGES_BASE_URL=https://example.invalid
CHANNEL_IMAGES_API_KEY=sk-replace-me

# Primary chat channel
CHANNEL_PRIMARY_BASE_URL=https://example.invalid
CHANNEL_PRIMARY_API_KEY=sk-replace-me

# Free-tier chat channel (public name: Keyo Free) — 由 services/unofree-pool 提供
# 下游密钥：粉丝/中转站调用接力池用的 key（New API 渠道里填这个）
POOL_API_KEYS=sk-pool-replace-me
CHANNEL_FREE_BASE_URL=http://127.0.0.1:3020
CHANNEL_FREE_API_KEY=sk-pool-replace-me

# Pool 1 — keyo-flash:free（跨多家免费/低价模型接力；每个上游各自的 origin+key+模型）
POOL_1_ALIAS=keyo-flash:free
POOL_1_UPSTREAMS=uno,intern,sensenova
POOL_1_BASE_URL_UNO=https://api.unorouter.com/v1
POOL_1_API_KEYS_UNO=sk-uno-replace-me,sk-uno-second
POOL_1_MODELS_UNO=agnes-3.0-flash:free,gemma-4-26b:free,glm-4.7-flash:free
POOL_1_BASE_URL_INTERN=https://discovery-api.intern-ai.org.cn/v1
POOL_1_API_KEYS_INTERN=sk-intern-replace-me
POOL_1_MODELS_INTERN=glm-5.3
POOL_1_BASE_URL_SENSENOVA=https://token.sensenova.cn/v1
POOL_1_API_KEYS_SENSENOVA=sk-sensenova-replace-me
POOL_1_MODELS_SENSENOVA=sensenova-6.8-flash-lite,glm-5.2

# Pool 2 — keyo-pro:free（付费模型低价优先接力；单上游简写示例）
POOL_2_ALIAS=keyo-pro:free
POOL_2_BASE_URL=https://api.openlux.ai/v1
POOL_2_API_KEYS=sk-openlux-replace-me
POOL_2_MODELS=gpt-6-luna,Bespoke-Nimble-9B,jev-1.13.0,qwen3.8-flash

# Video / specialty passthrough (:3011)
CHANNEL_VIDEO_BASE_URL=https://example.invalid
CHANNEL_VIDEO_API_KEY=sk-replace-me

# Specialty media passthrough (:3010)
CHANNEL_MEDIA_BASE_URL=https://example.invalid
CHANNEL_MEDIA_API_KEY=sk-replace-me

# New API admin
NEW_API_BASE=http://127.0.0.1:3000
NEW_API_ADMIN_USER=root
NEW_API_ADMIN_PASSWORD=your-admin-password

# Pricing workbook
ADMIN_PASSWORD=admin123
PORT=3100
