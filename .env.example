# 复制为 .env 后填写（.env 已在 .gitignore，不会提交）

# Grsai 上游（图片等）
GRSAI_BASE_URL=https://grsaiapi.com
GRSAI_API_KEY=sk-your-key-here

# OpenLux 上游（文本 OpenAI 兼容）
OPENLUX_BASE_URL=https://api.openlux.ai
OPENLUX_API_KEY=sk-your-openlux-key-here

# SenseNova Token Plan（免费对话；渠道对外名 Keyo Free，勿写供应商）
SENSENOVA_BASE_URL=https://token.sensenova.cn
SENSENOVA_API_KEY=sk-your-sensenova-key-here

# APIMart 视频（透传服务 :3011，勿提交真实 Key）
APIMART_BASE_URL=https://api.apimart.ai
APIMART_API_KEY=sk-your-apimart-key-here

# Gitee 模力方舟 Serverless（访问令牌：工作台 → 设置 → 访问令牌）
# 文档：https://ai.gitee.com/docs/openapi/v1
GITEE_BASE_URL=https://ai.gitee.com
GITEE_API_KEY=your-gitee-access-token

# New API 管理端
NEW_API_BASE=http://127.0.0.1:3000
NEW_API_ADMIN_USER=root
NEW_API_ADMIN_PASSWORD=your-admin-password

# 价格后台
ADMIN_PASSWORD=admin123
PORT=3100
