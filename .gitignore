# dependencies
node_modules/

# runtime / local data
data/

# env & secrets (.env.example kept)
.env
.env.*
!.env.example
!**/.env.example
credentials
**/credentials
*.pem

# logs
*.log
*.out.txt

# OS
.DS_Store

# python bytecode
__pycache__/

# binaries
bin/*.exe
bin/*.exe.*
**/*.exe
**/*.exe.*

# local temp / diagnostic artifacts
tmp/
tmp-*
_tmp_*
scripts/_*.txt

# VPS public smoke/deploy diagnostics — must survive safe-pull's `git stash -u`
# (untracked files get stashed-and-dropped; ignored files do not)
static/brand/smoke-status.txt
static/brand/deploy-status.txt
static/brand/smoke-status-e0cf117e.txt
static/brand/deploy-status-e0cf117e.txt

# GEO auto-published CMS articles (VPS-only; do not wipe on git reset)
static/brand/blog/article/*
!static/brand/blog/article/.gitkeep
# Cursor chat history export (local archive)
.cursor-history/
*.exe~
