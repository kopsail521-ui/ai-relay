              "role": "user",
              "parts": [
                {
                  "text": "Hello, welcome to KeyoAPI"
                }
              ]
            }
          ],
          "generationConfig": {
            "responseModalities": ["AUDIO"],
            "speechConfig": {
              "voiceConfig": {
                "prebuiltVoiceConfig": {
                  "voiceName": "Kore"
                }
              }
            }
          }
        },
        "output": "response.json",
        "noteKey": "The response is JSON containing base64 audio in candidates[].content.parts[].inlineData. Decode data and handle its mimeType before saving or playing audio."
      }
    ]
  },
