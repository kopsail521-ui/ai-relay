  "Qwen3-TTS": {
    "kind": "async-tts",
    "requests": [
      {
        "label": "/v1/async/audio/speech",
        "path": "/v1/async/audio/speech",
        "body": {
          "model": "Qwen3-TTS",
          "output_format": "mp3",
          "inputs": [
            {
              "prompt": "Hello, welcome to KeyoAPI",
              "language": "English",
              "speaker": "Vivian"
            }
          ]
        },
        "pollPath": "/v1/task/{id}",
        "noteKey": "Qwen3-TTS uses an inputs array; each item has prompt and language (Chinese or English). Legacy text or single-object input is normalized only for this model; omitted language defaults to Chinese. This example selects a built-in speaker; it does not clone a voice."
      }
    ]
  },
  "CosyVoice3": {
    "kind": "async-tts",
    "requests": [
      {
        "label": "/v1/async/audio/speech",
        "path": "/v1/async/audio/speech",
        "body": {
          "model": "CosyVoice3",
          "inputs": "Hello, welcome to KeyoAPI",
          "prompt_wav_url": "https://replace-me.invalid/your-reference.wav",
          "prompt_text": "Replace with the exact transcript of your reference audio."
        },
        "pollPath": "/v1/task/{id}",
        "noteKey": "Replace the reference URL with your accessible WAV or MP3 audio (at most 30 seconds, at least 16 kHz) and prompt_text with its exact transcript. These reference fields are required for this model; this is not a text-only built-in-voice example."
      }
    ]
  },
