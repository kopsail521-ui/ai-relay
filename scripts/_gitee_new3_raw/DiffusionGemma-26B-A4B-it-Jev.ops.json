[{"service":{"id":28100,"ident":"DiffusionGemma-26B-A4B-it-Jev","type":"serverless","vendor":"","region":"","compute":"","model":28796,"name":"DiffusionGemma-26B-A4B-it-Jev","remark":"DiffusionGemma-26B-A4B-it-NVFP4 是基于 Google DeepMind DiffusionGemma 26B A4B IT 构建的高性能扩散式语言模型，采用 Gemma 4 26B A4B 的 MoE 架构，总参数约 25.2B、每个 Token 激活约 3.8B 参数，并采用 NVFP4 低精度量化以降低推理显存和计算开销。","price":0.0000,"props":{"name":"diffusiongemma-26b-a4b-it","service_type":"serverless"},"inventories":0,"created_at":1790246026000,"updated_at":1790682234000,"sort_order":0,"status":1,"recommend":false,"cover":"https://gitee-ai.su.bcebos.com/v1/uploads/img/id-8f53nhb9z-WtA3YYitedOr9n02eHfJe.webp","description_html":"<p>与传统自回归模型逐 Token 生成不同，DiffusionGemma 采用离散块扩散（Block Diffusion）机制，在固定长度的 Token Canvas 上进行迭代去噪，并能够对一个 Token 块进行并行生成。这一特性不仅适用于文本生成，也使模型能够直接对预定义的候选答案进行概率读取，为结构化语义决策、分类、路由和 Agent 决策等场景提供高效的模型基础。</p><p>结合 JEV / System One 的结构化决策方式，可以将问题、上下文和候选选项转换为固定的答案空间，由模型直接读取不同选项的概率分布，而无需生成完整自然语言答案再进行解析。适用于 Agent 路由、工具选择、条件判断、结果评估、分类和自动化工作流等需要高频语义决策的场景。</p>","visible":true,"purchasable":true,"access_scope":"PUBLIC","sale_mode":"one_time","tags":[{"id":1220,"name":"64K","slug":"max_tokens_64k","icon":"https://gitee-ai.su.bcebos.com/v1/uploads/img/tag-icons/id-xroamij61-context_size (1).png","en_name":"64K","color":"blue","description":"上下文长度","href":"","created_at":1748699035394,"sort_order":0,"categories":[{"id":31,"parent_id":28,"name":"Serverless服务标签","slug":"serverless-service-label","created_at":1728529387723,"icon":"","sort_order":31,"en_name":""}]},{"id":1289,"name":"决策模型","slug":"Decision-Model","icon":"https://gitee-ai.su.bcebos.com/v1/uploads/img/tag-icons/id-pl0vcephv-3da23904-9e97-4541-8e1a-04e378e8a1d2.png","en_name":"Decision Model","color":"","description":"","href":"","created_at":1790681611720,"sort_order":0,"categories":[{"id":30,"parent_id":28,"name":"Serverless服务","slug":"serverless-service","created_at":1728529387723,"icon":"","sort_order":30,"en_name":""}]}],"model_info":{"id":28796,"name":"d